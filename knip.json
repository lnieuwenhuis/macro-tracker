{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "apps/web/public/sw.js",
    "packages/db/drizzle.config.ts",
    "packages/db/src/postgres-config.d.ts"
  ],
  "workspaces": {
    "apps/web": {
      "ignoreDependencies": ["tailwindcss"],
      "entry": [
        "app/**/{page,layout,route}.{ts,tsx}",
        "scripts/*.mjs",
        "tests/**/*.test.ts",
        "tests/fixtures/auth-render.mjs",
        "next.config.ts"
      ],
      "project": ["**/*.{ts,tsx,mts,mjs}"]
    },
    "packages/db": {
      "drizzle": false,
      "includeEntryExports": true,
      "entry": [
        "src/index.ts",
        "src/testing.ts",
        "src/migrate.ts",
        "src/test-backend-preflight.ts",
        "src/**/*.test.ts"
      ],
      "project": ["src/**/*.ts"]
    }
  }
}
