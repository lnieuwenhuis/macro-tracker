{
  "name": "macro-tracker",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "backend:check": "cargo check -p macro-tracker-backend",
    "backend:build": "cargo build --release -p macro-tracker-backend",
    "backend:start": "cargo run -p macro-tracker-backend",
    "backend:start:release": "./target/release/macro-tracker-backend",
    "backend:test": "cargo test -p macro-tracker-backend",
    "build": "pnpm --filter @macro-tracker/web build",
    "dev": "pnpm --filter @macro-tracker/web dev",
    "lint": "pnpm --filter @macro-tracker/web lint",
    "audit:unused": "knip --reporter compact",
    "audit:duplicates": "jscpd apps/backend/src apps/web packages/db/src --config .jscpd.json",
    "audit:code": "pnpm audit:unused && pnpm audit:duplicates",
    "test": "pnpm -r --parallel test",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @macro-tracker/web test:e2e",
    "db:generate": "pnpm --filter @macro-tracker/db db:generate",
    "db:migrate": "pnpm --filter @macro-tracker/db db:migrate",
    "db:studio": "pnpm --filter @macro-tracker/db db:studio"
  },
  "devDependencies": {
    "jscpd": "5.0.12",
    "knip": "6.29.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2",
      "postcss": "8.5.23",
      "nanoid": "3.3.18",
      "js-yaml": "4.3.1",
      "@babel/core": "7.29.6",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.0.2",
      "brace-expansion@5": "5.0.9"
    }
  }
}
